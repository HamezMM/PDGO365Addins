  <!-- ClickOnce publish settings for team distribution. `msbuild /t:Publish` writes the
       deployment (setup.exe, SheetToTxt.vsto, Application Files\) to PublishDir; put that
       folder in the OneDrive-synced SharePoint location so it propagates to the team.
       PublishDir is passed on the command line (it is a per-machine local path) by
       deploy\Publish-SheetToTxt.ps1. Install/Update URLs are the https address of that
       same SharePoint folder. Bump the version with the publish script. See deploy\README.md. -->
  <PropertyGroup>
